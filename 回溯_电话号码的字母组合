class Solution {
public:
    vector<string> res;
    vector<string> letterCombinations(string digits) {
        if (digits.empty())
            return res;
        unordered_map<char, string> numberStringMap = {
            {'2', "abc"}, {'3', "def"},  {'4', "ghi"}, {'5', "jkl"},
            {'6', "mno"}, {'7', "pqrs"}, {'8', "tuv"}, {'9', "wxyz"}};
        string cur;
        backtrack(digits, 0, cur, numberStringMap);
        return res;
    }

    void backtrack(string& digits, int index, string& cur,
                   unordered_map<char, string> numberStringMap) {
        if (index == digits.size()) {
            res.emplace_back(cur);
            return;
        }
        string& letters = numberStringMap[digits[index]];
        for (char c : letters) {
            cur.push_back(c);
            backtrack(digits, index + 1, cur, numberStringMap);
            cur.pop_back();
        }
    }
};
