class Solution {
public:
    int countSpecialNumbers(int n) {
        string s = to_string(n);
        int len = s.size();
        vector<vector<int>> memo(len, vector<int>(1 << 10, -1));

        function<int(int, int, bool, bool)> dfs =
            [&](int pos, int mask, bool limit, bool started) -> int {
            if (pos == len)
                return started ? 1 : 0;
            if (!limit && started && memo[pos][mask] != -1)
                return memo[pos][mask];

            int res = 0;
            if (!started)
                res += dfs(pos + 1, mask, false, false);

            int low = started ? 0 : 1;
            int high = limit ? s[pos] - '0' : 9;
            for (int d = low; d <= high; d++) {
                if ((mask >> d) & 1)
                    continue;
                res += dfs(pos + 1, mask | (1 << d), limit && d == high, true);
            }
            if (!limit && started)
                memo[pos][mask] = res;
            return res;
        };
        return dfs(0, 0, true, false);
    }
};
