class Solution {
public:
    int countSubstrings(string s) {
        int n = s.length();
        vector<vector<bool>> dp(n, vector<bool>(n, false));
        // dp->[i,j]bool
        int ans = 0;
        for (int i = n - 1; i >= 0; i--) {
            for (int j = i; j < n; j++) {
                if (s[i] == s[j]) {
                    if (j - i <= 1)
                        dp[i][j] = true, ans++;
                    else if (dp[i + 1][j - 1])
                        dp[i][j] = true, ans++;
                }
            }
        }
        return ans;
    }
};
