class Solution {
public:
    bool isCompleteTree(TreeNode* root) {
        if (!root)
            return true;
        int total = 0, maxId = 0;
        dfs(root, 1, total, maxId);
        return total == maxId;
    }

    void dfs(TreeNode* node, int id, int& total, int& maxId) {
        if (!node)
            return;
        total++;
        maxId = max(maxId, id);
        dfs(node->left, id * 2, total, maxId);
        dfs(node->right, id * 2 + 1, total, maxId);
    }
};
