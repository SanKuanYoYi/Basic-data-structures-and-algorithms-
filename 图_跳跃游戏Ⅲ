class Solution {
public:
    bool canReach(vector<int>& arr, int start) {
        if (arr[start] == 0)
            return true;
        int n = arr.size();
        vector<bool> visited(n, false);
        visited[start] = true;
        queue<int> q;
        q.push(start);
        while (!q.empty()) {
            int index = q.front();
            q.pop();
            if (arr[index] == 0)
                return true;
            for (int next : {index + arr[index], index - arr[index]}) {
                if (next >= 0 && next < n && !visited[next]) {
                    visited[next] = true;
                    q.push(next);
                }
            }
        }
        return false;
    }
};
