class Solution {
public:
    int maxLevelSum(TreeNode* root) {
        vector<int> levelSum;
        dfs(root, 0, levelSum);
        int maxIdx = 0;
        int maxSum = levelSum[0];
        for (int i = 1; i < levelSum.size(); i++) {
            if (levelSum[i] > maxSum) {
                maxSum = levelSum[i];
                maxIdx = i;
            }
        }
        return maxIdx + 1;
    }

    void dfs(TreeNode* node, int depth, vector<int>& levelSum) {
        if (!node)
            return;
        if (depth >= levelSum.size())
            levelSum.emplace_back(0);
        levelSum[depth] += node->val;
        dfs(node->left, depth + 1, levelSum);
        dfs(node->right, depth + 1, levelSum);
    }
};
