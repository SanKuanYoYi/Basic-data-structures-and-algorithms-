class Solution {
public:
    int ladderLength(string beginWord, string endWord,
                     vector<string>& wordList) {
        unordered_set<string> dict(wordList.begin(), wordList.end());
        if (!dict.count(endWord))
            return 0;
        unordered_map<string, vector<string>> matches;
        int n = beginWord.size();
        for (auto& word : dict) {
            for (int i = 0; i < n; i++) {
                string next = word.substr(0, i) + "*" + word.substr(i + 1);
                matches[next].push_back(word);
            }
        }

        queue<pair<string, int>> q;
        unordered_set<string> visited;
        q.push({beginWord, 1});
        visited.insert(beginWord);

        while (!q.empty()) {
            auto [cur, cnt] = q.front();
            q.pop();
            for (int i = 0; i < n; i++) {
                string next = cur.substr(0, i) + "*" + cur.substr(i + 1);
                for (auto& maybePrev : matches[next]) {
                    if (maybePrev == endWord)
                        return cnt + 1;
                    if (!visited.count(maybePrev)) {
                        visited.insert(maybePrev);
                        q.push({maybePrev, cnt + 1});
                    }
                }
            }
        }
        return 0;
    }
};
