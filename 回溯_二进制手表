class Solution {
public:
    vector<string> readBinaryWatch(int turnedOn) {
        vector<int> hours = {1, 2, 4, 8};
        vector<int> minutes = {1, 2, 4, 8, 16, 32};
        vector<string> ans;
        int h = 0, m = 0, left = turnedOn;
        backtrack(0, h, m, left, hours, minutes, ans);
        return ans;
    }

    void backtrack(int start, int& h, int& m, int& left,
                   const vector<int>& hours, const vector<int>& minutes,
                   vector<string>& ans) {
        if (left == 0) {
            if (h <= 11 && m <= 59) {
                string time = to_string(h) + ":" +
                              (m < 10 ? "0" + to_string(m) : to_string(m));
                ans.push_back(time);
            }
            return;
        }
        for (int i = start; i < 10; ++i) {
            if (i < 4) {
                h += hours[i];
                left--;
                backtrack(i + 1, h, m, left, hours, minutes, ans);
                left++;
                h -= hours[i];
            } else {
                m += minutes[i - 4];
                left--;
                backtrack(i + 1, h, m, left, hours, minutes, ans);
                left++;
                m -= minutes[i - 4];
            }
        }
    }
};
