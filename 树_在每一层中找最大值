class Solution {
public:
    vector<int> largestValues(TreeNode* root) {
        vector<int> ans;
        if (!root)
            return ans;
        dfs(root, 0, ans);
        return ans;
    }

    void dfs(TreeNode* node, int depth, vector<int>& ans) {
        if (!node)
            return;
        if (depth == ans.size())
            ans.emplace_back(node->val);
        else
            ans[depth] = max(ans[depth], node->val);
        dfs(node->left, depth + 1, ans);
        dfs(node->right, depth + 1, ans);
    }
};
