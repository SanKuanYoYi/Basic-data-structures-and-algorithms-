/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left),
 * right(right) {}
 * };
 */
class Solution {
public:
    int ans = 0;

    int longestZigZag(TreeNode* root) {
        dfs(root, 0, true);
        return ans;
    }

    void dfs(TreeNode* root, int length, bool isLeft) {
        if (!root)
            return;
        ans = max(ans, length);
        dfs(root->left, isLeft ? 1 : length + 1, true);
        dfs(root->right, !isLeft ? 1 : length + 1, false);
    }
};
