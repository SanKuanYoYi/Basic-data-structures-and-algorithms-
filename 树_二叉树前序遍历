class Solution {
public:
    vector<int> preorderTraversal(TreeNode* root) {
        vector<int> ans;
        if (!root)
            return ans;
        stack<TreeNode*> tree;
        tree.push(root);
        while (!tree.empty()) {
            TreeNode* node = tree.top();
            tree.pop();
            ans.emplace_back(node->val);
            if (node->right)
                tree.push(node->right);
            if (node->left)
                tree.push(node->left);
        }
        return ans;
    }
};
