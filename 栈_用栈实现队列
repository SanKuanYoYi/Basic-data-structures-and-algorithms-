class MyQueue {
public:
    stack<int> inStack, outStack;

    void transfer() {
        if (outStack.empty()) {
            while (!inStack.empty()) {
                outStack.push(inStack.top());
                inStack.pop();
            }
        }
    }

    MyQueue() {}

    void push(int x) { inStack.push(x); }

    int pop() {
        transfer();
        int top = outStack.top();
        outStack.pop();
        return top;
    }

    int peek() {
        transfer();
        return outStack.top();
    }

    bool empty() { return inStack.empty() && outStack.empty(); }
};

