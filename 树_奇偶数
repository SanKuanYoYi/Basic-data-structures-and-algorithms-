class Solution {
public:
    bool isEvenOddTree(TreeNode* root) {
        if (!root)
            return true;
        vector<int> prevVals;
        return dfs(root, 0, prevVals);
    }

    bool dfs(TreeNode* root, int depth, vector<int>& prevVals) {
        if (!root)
            return true;
        if (depth % 2 == 0) {
            if (root->val % 2 == 0)
                return false;
        } else {
            if (root->val % 2 == 1)
                return false;
        }
        if (depth == prevVals.size()) {
            if (depth % 2 == 0)
                prevVals.emplace_back(INT_MIN);
            else
                prevVals.emplace_back(INT_MAX);
        }
        if (depth % 2 == 0) {
            if (root->val <= prevVals[depth])
                return false;
        } else {
            if (root->val >= prevVals[depth])
                return false;
        }
        prevVals[depth] = root->val;
        return dfs(root->left, depth + 1, prevVals) &&
               dfs(root->right, depth + 1, prevVals);
    }
};
