class Solution {
public:
    vector<int> findMode(TreeNode* root) {
        vector<int> ans;
        int curVal = 0, curCount = 0, maxCount = 0;
        inorder(root, curVal, curCount, maxCount, ans);
        if (curCount > maxCount) {
            ans = {curVal};
        } else if (curCount == maxCount && curCount != 0) {
            ans.push_back(curVal);
        }
        return ans;
    }

    void inorder(TreeNode* node, int& curVal, int& curCount, int& maxCount,
                 vector<int>& ans) {
        if (!node)
            return;
        inorder(node->left, curVal, curCount, maxCount, ans);
        if (curCount == 0) {
            curVal = node->val;
            curCount = 1;
        } else if (node->val == curVal) {
            curCount++;
        } else {
            if (curCount > maxCount) {
                maxCount = curCount;
                ans.clear();
                ans.push_back(curVal);
            } else if (curCount == maxCount) {
                ans.push_back(curVal);
            }
            curVal = node->val;
            curCount = 1;
        }
        inorder(node->right, curVal, curCount, maxCount, ans);
    }
};
