class Solution {
public:
    bool wordBreak(string s, vector<string>& wordDict) {
        unordered_set<string> wordSet(wordDict.begin(), wordDict.end());
        int m = s.length();
        vector<bool> dp(m + 1, false);
        dp[0] = true;
        for (int i = 1; i <= m; i++) {
            for (int j = 0; j < i; j++) {
                string ss = s.substr(j, i - j);
                if (wordSet.count(ss) && dp[j])
                    dp[i] = true;
            }
        }
        return dp[m];
    }
};
