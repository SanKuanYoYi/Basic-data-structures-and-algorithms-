class Solution {
public:
    int res = 0;
    int dfs(TreeNode* root, int val) {
        if (!root)
            return 0;
        int left = dfs(root->left, root->val);
        int right = dfs(root->right, root->val);
        res = max(res, left + right);
        return root->val == val ? max(left, right) + 1 : 0;
    }
    int longestUnivaluePath(TreeNode* root) {
        if (!root)
            return 0;
        dfs(root, root->val);
        return res;
    }
};
