class Solution {
public:
    int findContentChildren(vector<int>& g, vector<int>& s) {
        sort(g.begin(), g.end());
        sort(s.begin(), s.end());
        int ans = 0;
        int idxg = g.size() - 1, idxs = s.size() - 1;
        while (idxg >= 0 && idxs >= 0) {
            if (s[idxs] >= g[idxg]) {
                ans++;
                idxg--;
                idxs--;
            } else
                idxg--;
        }
        return ans;
    }
};
