class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {

        /*
        int size = nums.size();
        for (int i = 0; i < size; i++) {
            for (int j = i + 1; j < size; j++) {
                if (nums[i] + nums[j] == target)
                    return { i, j };
            }
        }
        return {};
        */

        unordered_map<int, int> match;
        for (int i = 0; i < nums.size(); i++) {
            unordered_map<int, int>::iterator it = match.find(target - nums[i]);
            if (it != match.end())
                return {it->second, i};
            match[nums[i]] = i;
        }
        return {};
    }
};
