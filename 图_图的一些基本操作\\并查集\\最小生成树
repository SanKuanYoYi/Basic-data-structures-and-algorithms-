#include <iostream>
#include <vector>
#include <queue>
#include <numeric>
#include <algorithm>

class GraphMatrix {

private:
	int vertexNum; // 顶点数
	std::vector<std::vector<int>> matrix; // 邻接矩阵
	bool directed; // 是否有向图

public:
	GraphMatrix(int n, bool directed) :vertexNum(n), directed(directed) {
		matrix.resize(vertexNum, std::vector<int>(vertexNum, 0));
	}

	void addEdge(int u, int v, int weight = 1) {
		if(u>=vertexNum || v>=vertexNum) {
			std::cerr << "Error: Vertex index out of bounds." << std::endl;
			return;
		}
		matrix[u][v] = weight;
		if(!directed) {
			matrix[v][u] = weight;
		}
	}

	void removeEdge(int u, int v) {
		if(u>=vertexNum || v>=vertexNum) {
			std::cerr << "Error: Vertex index out of bounds." << std::endl;
			return;
		}
		matrix[u][v] = 0;
		if(!directed) {
			matrix[v][u] = 0;
		}
	}

	void addVertex() {
		vertexNum++;
		matrix.resize(vertexNum);
		for(auto& row : matrix) {
			row.resize(vertexNum, 0);
		}
	}

	bool hasEdge(int u, int v) {
		if(u>=vertexNum || v>=vertexNum) {
			std::cerr << "Error: Vertex index out of bounds." << std::endl;
			return false;
		}
		return matrix[u][v] != 0;
	}

	std::vector<int> getNeighbors(int u) {
		std::vector<int> neighbors;
		if(u>=vertexNum) {
			std::cerr << "Error: Vertex index out of bounds." << std::endl;
			return neighbors;
		}
		for(int v = 0; v < vertexNum; v++) {
			if(matrix[u][v] != 0) {
				neighbors.push_back(v);
			}
		}
		return neighbors;
	}

	void printGraph() {
		for(int i = 0; i < vertexNum; i++) {
			for(int j = 0; j < vertexNum; j++) {
				std::cout << matrix[i][j] << " ";
			}
			std::cout << std::endl;
		}
	}

	void bfs(int start) {
		if(start >= vertexNum) {
			std::cerr << "Error: Vertex index out of bounds." << std::endl;
			return;
		}
		std::vector<bool> visited(vertexNum, false);
		std::queue<int> q;
		q.push(start);
		visited[start] = true;
		while(!q.empty()) {
			int u = q.front();
			q.pop();
			std::cout << "Visited vertex: " << u << std::endl;
			for(int v = 0; v < vertexNum; v++) {
				if(matrix[u][v] != 0 && !visited[v]) {
					q.push(v);
					visited[v] = true;
				}
			}
		}
	}	

	void dfs(int start, std::vector<bool>& visited) {
		if(start >= vertexNum) {
			std::cerr << "Error: Vertex index out of bounds." << std::endl;
			return;
		}
		visited[start] = true;
		std::cout << "Visited vertex: " << start << std::endl;
		for(int v = 0; v < vertexNum; v++) {
			if(matrix[start][v] != 0 && !visited[v]) {
				dfs(v, visited);
			}
		}
	}
	void dfs(int start) {
		std::vector<bool> visited(vertexNum, false);
		dfs(start, visited);
	}

	int primMst() const {
		const int INF = 1e9;
		std::vector<bool> visited(vertexNum, false);
		std::vector<int> minDist(vertexNum, INF);
		minDist[0] = 0;
		int total = 0;

		for (int i = 0; i < vertexNum; ++i) {
			int u = -1;
			for (int j = 0; j < vertexNum; ++j)
				if (!visited[j] && (u == -1 || minDist[j] < minDist[u]))
					u = j;
			if (minDist[u] == INF) return -1;
			visited[u] = true;
			total += minDist[u];
			for (const auto& edge : matrix[u]) {
				int v = &edge - &matrix[u][0];
				int weight = edge;
				if (!visited[v] && weight != 0 && weight < minDist[v])
					minDist[v] = weight;
			}
		}
		return total;
	}
};

