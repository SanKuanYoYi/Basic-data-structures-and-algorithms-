class Solution {
public:
    int monotoneIncreasingDigits(int n) {
        string s = to_string(n);
        int nineStart = s.length();
        for (int i = s.length() - 1; i > 0; i--) {
            if (s[i - 1] > s[i]) {
                nineStart = i;
                s[i - 1]--;
            }
        }
        for (int i = nineStart; i < s.length(); i++)
            s[i] = '9';
        return stoi(s);
    }
};
