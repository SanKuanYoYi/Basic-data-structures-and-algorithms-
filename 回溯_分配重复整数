class Solution {
public:
    bool canDistribute(vector<int>& nums, vector<int>& quantity) {
        unordered_map<int, int> cnt;
        for (int num : nums)
            cnt[num]++;
        vector<int> cntWithIdx;
        for (auto& it : cnt)
            cntWithIdx.emplace_back(it.second);
        sort(quantity.begin(), quantity.end(), greater<int>());
        return backtrack(quantity, cntWithIdx, 0);
    }

    bool backtrack(vector<int>& quantity, vector<int>& cntWithIdx, int index) {
        if (index == quantity.size())
            return true;
        for (int i = 0; i < cntWithIdx.size(); i++) {
            if (cntWithIdx[i] >= quantity[index]) {
                cntWithIdx[i] -= quantity[index];
                if (backtrack(quantity, cntWithIdx, index + 1))
                    return true;
                cntWithIdx[i] += quantity[index];
            }
        }
        return false;
    }
};
