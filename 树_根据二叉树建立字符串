class Solution {
public:
    string tree2str(TreeNode* root) {
        if (!root)
            return "";
        string ans = "";
        stack<TreeNode*> stk;
        stk.push(root);
        unordered_set<TreeNode*> record;
        while (!stk.empty()) {
            TreeNode* node = stk.top();
            if (record.count(node)) {
                stk.pop();
                ans += ')';
            } else {
                record.insert(node);
                ans += '(' + to_string(node->val);
                if (!node->left && node->right)
                    ans += "()";
                if (node->right)
                    stk.push(node->right);
                if (node->left)
                    stk.push(node->left);
            }
        }
        return ans.substr(1, ans.size() - 2);
    }
};
