    int jump(vector<int>& nums) {
        int n = nums.size();
        if (n <= 1)
            return 0;
        int steps = 0;
        int left = 0, right = 0;
        while (right < n - 1) {
            int maxReach = 0;
            for (int i = left; i <= right; ++i) {
                maxReach = max(maxReach, i + nums[i]);
            }
            left = right + 1;
            right = maxReach;
            ++steps;
        }
        return steps;
    }
};
