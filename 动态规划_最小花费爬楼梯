class Solution {
public:
    int minCostClimbingStairs(vector<int>& cost) {
        int size = cost.size();
        int dp_pre1 = 0;
        int dp_pre2 = 0;
        int dp_cur;
        for (int i = 2; i <= size; i++) {
            dp_cur = min(dp_pre1 + cost[i - 1], dp_pre2 + cost[i - 2]);
            dp_pre2 = dp_pre1;
            dp_pre1 = dp_cur;
        }
        return dp_cur;
    }
};
