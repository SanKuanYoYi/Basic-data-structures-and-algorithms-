class Solution {
public:
    string shortestCommonSupersequence(string s1, string s2) {
        int n = s1.size(), m = s2.size();
        vector<vector<int>> dp(n + 1, vector<int>(m + 1, 0));
        // 计算 LCS 长度
        for (int i = 1; i <= n; ++i) {
            for (int j = 1; j <= m; ++j) {
                if (s1[i - 1] == s2[j - 1])
                    dp[i][j] = dp[i - 1][j - 1] + 1;
                else
                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
            }
        }
        // 回溯构建结果
        string ans = "";
        int i = n, j = m;
        while (i > 0 && j > 0) {
            if (s1[i - 1] == s2[j - 1]) {
                ans.push_back(s1[i - 1]);
                i--, j--;
            } else if (dp[i - 1][j] >= dp[i][j - 1]) {
                ans.push_back(s1[i - 1]);
                i--;
            } else {
                ans.push_back(s2[j - 1]);
                j--;
            }
        }
        // 剩余字符处理
        while (i > 0)
            ans.push_back(s1[--i]);
        while (j > 0)
            ans.push_back(s2[--j]);
        reverse(ans.begin(), ans.end());
        return ans;
    }
};
