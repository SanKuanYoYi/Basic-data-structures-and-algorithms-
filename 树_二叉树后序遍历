class Solution {
public:
    vector<int> postorderTraversal(TreeNode* root) {
        vector<int> ans;
        if (!root)
            return ans;
        stack<pair<TreeNode*, bool>> tree;
        tree.push({root, false});
        while (!tree.empty()) {
            pair<TreeNode*, bool> p = tree.top();
            TreeNode* node = p.first;
            bool visited = p.second;
            tree.pop();
            if (!node)
                continue;
            if (visited)
                ans.emplace_back(node->val);
            else {
                tree.push({node, true});
                tree.push({node->right, false});
                tree.push({node->left, false});
            }
        }
        return ans;
    }
};
