class Solution {
public:
    int eraseOverlapIntervals(vector<vector<int>>& intervals) {
        if (intervals.empty())
            return 0;
        sort(intervals.begin(), intervals.end(),
             [](const vector<int>& a, const vector<int>& b) {
                 return a[1] < b[1];
             });
        int keep = 1;
        int end = intervals[0][1];
        for (auto& interval : intervals) {
            if (interval[0] >= end) {
                keep++;
                end = interval[1];
            }
        }
        return intervals.size() - keep;
    }
};
