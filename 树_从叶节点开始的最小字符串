class Solution {
public:
    string ans;

    string smallestFromLeaf(TreeNode* root) {
        dfs(root, "");
        return ans;
    }

    void dfs(TreeNode* node, string cur) {
        if (!node)
            return;
        cur = char('a' + node->val) + cur;
        if (!node->left && !node->right) {
            if (!ans.length() || cur < ans)
                ans = cur;
            return;
        }
        dfs(node->left, cur);
        dfs(node->right, cur);
    }
};
