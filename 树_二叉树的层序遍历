class Solution {
public:
    vector<vector<int>> levelOrder(TreeNode* root) {
        vector<vector<int>> ans;
        if (!root)
            return ans;
        queue<TreeNode*> cur, next;
        cur.push(root);
        while (!cur.empty()) {
            vector<int> levelVal;
            while (!cur.empty()) {
                TreeNode* node = cur.front();
                cur.pop();
                levelVal.push_back(node->val);
                if (node->left)
                    next.push(node->left);
                if (node->right)
                    next.push(node->right);
            }
            ans.push_back(levelVal);
            cur = next;
            while (!next.empty()) {
                next.pop();
            }
        }
        return ans;
    }
};
