class Solution {
public:
    bool isAdditiveNumber(string num) {
        int n = num.size();
        for (int len1 = 1; len1 <= n / 2; len1++) {
            for (int len2 = 1; max(len1, len2) <= n - len1 - len2; len2++) {
                if ((len1 > 1 && num[0] == '0') ||
                    (len2 > 1 && num[len1] == '0'))
                    continue;
                string s1 = num.substr(0, len1);
                string s2 = num.substr(len1, len2);
                long long a = stoll(s1), b = stoll(s2);
                int start = len1 + len2;
                bool valid = true;
                while (start < n) {
                    long long c = a + b;
                    string sc = to_string(c);
                    if (num.substr(start, sc.size()) != sc) {
                        valid = false;
                        break;
                    }
                    start += sc.size();
                    a = b;
                    b = c;
                }
                if (valid)
                    return true;
            }
        }
        return false;
    }
};
