/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left),
 * right(right) {}
 * };
 */
class Solution {
public:
    struct Info {
        bool isBST;
        long long minVal;
        long long maxVal;
        long long sum;
    };

    int maxSum = LONG_MIN;
    int maxSumBST(TreeNode* root) {
        if (!root)
            return 0;
        dfs(root);
        return maxSum;
    }

    Info dfs(TreeNode* root) {
        if (!root)
            return Info(true, LLONG_MAX, LLONG_MIN, 0);
        Info left = dfs(root->left);
        Info right = dfs(root->right);
        if (left.isBST && right.isBST && root->val > left.maxVal &&
            root->val < right.minVal) {
            long long curSum = left.sum + right.sum + root->val;
            long long curMin =
                (left.minVal == LLONG_MAX) ? root->val : left.minVal;
            long long curMax =
                (right.maxVal == LLONG_MIN) ? root->val : right.maxVal;
            maxSum = max(maxSum, (int)curSum);
            return Info(true, curMin, curMax, curSum);
        } else
            return Info(false, 0, 0, 0);
    }
};
