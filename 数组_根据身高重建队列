class Solution {
public:
    vector<vector<int>> reconstructQueue(vector<vector<int>>& people) {
        sort(people.begin(), people.end(),
             [](const vector<int>& h, const vector<int>& k) {
                 return h[0] > k[0] || (h[0] == k[0] && h[1] < k[1]);
             });
        for (int i = 0; i < people.size(); i++) {
            int toIdx = 0;
            if (i != people[i][1]) {
                toIdx = people[i][1];
                vector<int> temp = people[i];
                people.erase(people.begin() + i);
                people.insert(people.begin() + toIdx, temp);
            }
        }
        return people;
    }
};
