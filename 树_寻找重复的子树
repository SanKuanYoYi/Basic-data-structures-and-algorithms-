class Solution {
public:
    vector<TreeNode*> findDuplicateSubtrees(TreeNode* root) {
        vector<TreeNode*> ans;
        unordered_map<string, int> id;
        unordered_map<int, int> cnt;
        dfs(root, ans, id, cnt);
        return ans;
    }

    int dfs(TreeNode* root, vector<TreeNode*>& ans,
            unordered_map<string, int>& id, unordered_map<int, int>& cnt) {
        if (!root)
            return 0;
        int leftID = dfs(root->left, ans, id, cnt);
        int rightID = dfs(root->right, ans, id, cnt);
        string key = to_string(root->val) + " " + to_string(leftID) + " " +
                     to_string(rightID);
        if (!id.count(key))
            id[key] = id.size() + 1;
        int curId = id[key];
        if (++(cnt[curId]) == 2)
            ans.emplace_back(root);
        return curId;
    }
};
