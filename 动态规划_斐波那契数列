class Solution {
public:
    int fib(int n) {
        if (n == 0)
            return 0;
        if (n == 1)
            return 1;
        int dp_pre2 = 0;
        int dp_pre1 = 1;
        int dp_cur;
        for (int i = 2; i <= n; i++) {
            dp_cur = dp_pre1 + dp_pre2;
            dp_pre2 = dp_pre1;
            dp_pre1 = dp_cur;
        }
        return dp_cur;
    }
};
