class Solution {
public:
    vector<vector<int>> combinationSum3(int k, int n) {
        vector<vector<int>> ans;
        vector<int> path;
        backtrack(ans, path, 1, k, n);
        return ans;
    }

    void backtrack(vector<vector<int>>& ans, vector<int>& path, int start,
                   int k, int n) {
        if (n < 0 || path.size() > k)
            return;
        if (!n && path.size() == k) {
            ans.push_back(path);
            return;
        }
        for (int i = start; i <= 9 && i <= n; i++) {
            if (9 - i + 1 < k - path.size())
                break;
            path.push_back(i);
            backtrack(ans, path, i + 1, k, n - i);
            path.pop_back();
        }
    }
};
