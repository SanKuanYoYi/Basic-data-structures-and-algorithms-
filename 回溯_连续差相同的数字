class Solution {
public:
    vector<int> ans;

    vector<int> numsSameConsecDiff(int n, int k) {
        for (int i = 1; i <= 9; i++)
            backtrack(i, n - 1, k, ans);
        return ans;
    }

    void backtrack(int num, int remaining, int k, vector<int>& res) {
        if (!remaining) {
            ans.push_back(num);
            return;
        }
        int last = num % 10;
        int next1 = last + k;
        if (next1 < 10)
            backtrack(num * 10 + next1, remaining - 1, k, ans);

        if (k != 0) {
            int next2 = last - k;
            if (next2 >= 0)
                backtrack(num * 10 + next2, remaining - 1, k, res);
        }
    }
};

