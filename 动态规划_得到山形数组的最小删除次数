class Solution {
public:
    int minimumMountainRemovals(vector<int>& nums) {
        int n = nums.size();
        vector<int> left(n, 1), right(n, 1);
        // left[i]：以 nums[i] 结尾的最长严格递增子序列的长度
        // right[i]：以 nums[i] 开头的最长严格递减子序列的长度
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < i; ++j) {
                if (nums[j] < nums[i])
                    left[i] = max(left[i], left[j] + 1);
            }
        }
        for (int i = n - 1; i >= 0; --i) {
            for (int j = n - 1; j > i; --j) {
                if (nums[j] < nums[i])
                    right[i] = max(right[i], right[j] + 1);
            }
        }
        int maxLen = 0;
        for (int i = 0; i < n; ++i) {
            if (left[i] >= 2 && right[i] >= 2) {
                maxLen = max(maxLen, left[i] + right[i] - 1);
            }
        }
        return n - maxLen;
    }
};
