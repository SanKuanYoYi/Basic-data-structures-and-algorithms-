class Solution {
public:
    vector<int> parent;

    int find(int x) {
        if (parent[x] != x)
            parent[x] = find(parent[x]);
        return parent[x];
    }

    void unite(int x, int y) {
        int rx = find(x), ry = find(y);
        if (rx != ry)
            parent[rx] = ry;
    }

    vector<int> findRedundantConnection(vector<vector<int>>& edges) {
        int n = edges.size();
        parent.resize(n + 1);
        for (int i = 0; i < n; i++)
            parent[i] = i;

        for (auto& edge : edges) {
            if (find(edge[0]) == find(edge[1]))
                return {edge[0], edge[1]};
            unite(edge[0], edge[1]);
        }
        return {};
    }
};
