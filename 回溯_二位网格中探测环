class Solution {
public:
    vector<pair<int, int>> direct = {{0, 1}, {0, -1}, {1, 0}, {-1, 0}};

    bool containsCycle(vector<vector<char>>& grid) {
        int m = grid.size(), n = grid[0].size();
        vector<vector<bool>> visited(m, vector<bool>(n, false));
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (!visited[i][j])
                    if (backtrack(grid, m, n, visited, i, j, -1, -1))
                        return true;
            }
        }
        return false;
    }

    bool backtrack(vector<vector<char>>& grid, int m, int n,
                   vector<vector<bool>>& visited, int i, int j, int prevI,
                   int prevJ) {
        if (visited[i][j])
            return true;
        visited[i][j] = true;
        for (auto [di, dj] : direct) {
            int nextI = i + di;
            int nextJ = j + dj;
            if (nextI < 0 || nextI >= m || nextJ < 0 || nextJ >= n)
                continue;
            if (grid[nextI][nextJ] != grid[i][j])
                continue;
            if (nextI == prevI && nextJ == prevJ)
                continue;
            if (backtrack(grid, m, n, visited, nextI, nextJ, i, j))
                return true;
        }
        return false;
    }
};
