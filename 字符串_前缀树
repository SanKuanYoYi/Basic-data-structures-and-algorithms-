class Trie {
private:
    bool isEnd;
    Trie* next[26];

public:
    Trie() {
        isEnd = false;
        for (int i = 0; i < 26; i++)
            next[i] = 0;
    }

    void insert(string word) {
        Trie* node = this;
        for (char c : word) {
            if (node->next[c - 'a'] == NULL)
                node->next[c - 'a'] = new Trie();
            node = node->next[c - 'a'];
        }
        node->isEnd = true;
    }

    bool search(string word) {
        Trie* node = this;
        for (char c : word) {
            node = node->next[c - 'a'];
            if (!node)
                return false;
        }
        return node->isEnd;
    }

    bool startsWith(string prefix) {
        Trie* node = this;
        for (char c : prefix) {
            node = node->next[c - 'a'];
            if (!node)
                return false;
        }
        return true;
    }
};

