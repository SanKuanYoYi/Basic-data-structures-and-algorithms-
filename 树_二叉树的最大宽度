class Solution {
public:
    vector<unsigned long long> firstPos;

    int widthOfBinaryTree(TreeNode* root) {
        if (!root)
            return 0;
        int maxWidth = 0;
        dfs(root, 1, 1, maxWidth);
        return maxWidth;
    }

    void dfs(TreeNode* node, unsigned long long id, int depth, int& maxWidth) {
        if (!node)
            return;
        if (firstPos.size() < depth) {
            firstPos.push_back(id);
        }
        maxWidth = max(maxWidth, (int)(id - firstPos[depth - 1] + 1));
        dfs(node->left, id * 2, depth + 1, maxWidth);
        dfs(node->right, id * 2 + 1, depth + 1, maxWidth);
    }
};
