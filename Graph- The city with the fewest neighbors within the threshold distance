class Solution {
public:
    int findTheCity(int n, vector<vector<int>>& edges, int distanceThreshold) {
        vector<vector<int>> dist(n, vector<int>(n, 1e9));
        for (auto& e : edges) {
            int u = e[0], v = e[1], w = e[2];
            dist[u][v] = dist[v][u] = w;
        }

        for (int k = 0; k < n; k++) {
            for (int i = 0; i < n; i++) {
                if (dist[i][k] == 1e9)
                    continue;
                for (int j = 0; j < n; j++) {
                    if (dist[k][j] == 1e9)
                        continue;
                    int nesDist = dist[i][k] + dist[k][j];
                    if (nesDist < dist[i][j])
                        dist[i][j] = nesDist;
                }
            }
        }

        int ans = -1; // 标号
        int minCnt = n;
        for (int i = 0; i < n; i++) {
            int cnt = 0;
            for (int j = 0; j < n; j++) {
                if (i != j && dist[i][j] <= distanceThreshold)
                    cnt++;
            }

            if (cnt < minCnt) {
                minCnt = cnt;
                ans = i;
            } else if (cnt == minCnt && i > ans)
                ans = i;
        }
        return ans;
    }
};
