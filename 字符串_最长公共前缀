        */

        int size = strs.size();
        if (!size)
            return "";
        int len = strs[0].size();
        for (int i = 0; i < len; i++) {
            char c = strs[0][i];
            for (int j = 1; j < size; j++) {
                if (i == strs[j].size() || strs[j][i] != c)
                    return strs[0].substr(0, i);
            }
        }
        return strs[0];
    }
};
