class Solution {
public:
    int climbStairs(int n) {
        if (!n)
            return 0;
        if (n == 1)
            return 1;
        if (n == 2)
            return 2;
        int dp_pre1 = 2;
        int dp_pre2 = 1;
        int dp_cur = 0;
        for (int i = 3; i <= n; i++) {
            dp_cur = dp_pre1 + dp_pre2;
            dp_pre2 = dp_pre1;
            dp_pre1 = dp_cur;
        }
        return dp_cur;
    }
};
