class Solution {
public:
    int numberOfSpecialChars(string word) {
        unordered_set<char> record(word.begin(), word.end());
        int ans = 0;
        for (char c = 'a'; c <= 'z'; c++)
            if (record.count(c) && record.count(c - 'a' + 'A'))
                ans++;
        return ans;
    }
};
