class Solution {
public:
    int minMutation(string startGene, string endGene, vector<string>& bank) {
        if(startGene==endGene)return 0;
        unordered_set<string> dict(bank.begin(), bank.end());
        if (!dict.count(endGene))
            return -1;
        unordered_map<string, vector<string>> matches;
        int n = startGene.size();
        for (auto& gene : dict) {
            for (int i = 0; i < n; i++) {
                string nextGene =
                    gene.substr(0, i) + "*" + gene.substr(i + 1);
                matches[nextGene].push_back(gene); // maynext->prev
            }
        }

        queue<pair<string, int>> q; // cnt
        unordered_set<string> visited;
        q.push({startGene, 0});
        visited.insert(startGene);

        while (!q.empty()) {
            auto [cur, cnt] = q.front();
            q.pop();
            for (int i = 0; i < n; i++) {
                string nextGene = cur.substr(0, i) + "*" + cur.substr(i + 1);
                for (auto& maybePrev : matches[nextGene]) {
                    if (maybePrev == endGene)
                        return cnt + 1;
                    if (!visited.count(maybePrev)) {
                        visited.insert(maybePrev);
                        q.push({maybePrev, cnt + 1});
                    }
                }
            }
        }
        return -1;
    }
};
